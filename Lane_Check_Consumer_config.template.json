{
    "log_Level": "DEBUG",
    "Log_Console": 1,
    "log_Backup": 90,
    "Log_Size": "100 MB",

    "RabbitMQ": {
        "Host": "CHANGE_ME_RABBITMQ_HOST",
        "Port": 5672,
        "VHost": "/",
        "Username": "guest",
        "Password": "CHANGE_ME_ON_FIRST_RUN",
        "Queue": "system_status",
        "Durable": 1,
        "Prefetch": 20,
        "Connection_Timeout": 10,
        "Reconnect_Delay": 5
    },

    "Save_Received": {
        "Enable": 1,
        "Directory": "received",
        "Daily_Subdir": 1
    }
}
